FROM python:3.10-slim

WORKDIR /app

# Instalar dependencias estrictamente necesarias para servir el modelo
RUN pip --default-timeout=3000 --retries 10 install torch --extra-index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir fastapi uvicorn pydantic

# Copiar solo los directorios requeridos para la inferencia
COPY ./models /app/models
COPY ./artifacts /app/artifacts
COPY app.py /app/app.py

# Exponer el puerto de FastAPI
EXPOSE 8000

# Levantar el servidor Uvicorn
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
